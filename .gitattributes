# GitHub Linguist language statistics configuration
# Priority languages: TypeScript, Svelte, Kotlin, Swift, Go, Rust, Wasm

# Exclude compiled, generated, or non-primary web assets
*.js linguist-detectable=false
*.cjs linguist-detectable=false
*.jsx linguist-detectable=false
*.html linguist-detectable=false
*.css linguist-detectable=false
*.scss linguist-detectable=false
*.xml linguist-detectable=false

# Mark large assets as vendored (omitted from stats)
*.onnx linguist-vendored=true
*.mlpackage/* linguist-vendored=true
*.bin linguist-vendored=true
shared/locales/*.csv linguist-vendored=true
