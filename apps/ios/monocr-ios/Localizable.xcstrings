    "about_vulnerable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mon (mnw) is my mother tongue. It is currently classified as a vulnerable language by UNESCO."
          }
        },
        "mnw": {
          "stringUnit": {
            "state": "translated",
            "value": "ဘာသာမန် (mnw) ဂှ် ဒှ်အရေဝ်မိအဲရ။ ပ္ဍဲအခိင်လၟုဟ် ညးစကာအောန်စှ်ေကၠုင်တုဲ UNESCO ဟီုလဝ် ဒှ်ဘာသာ မဒးမင်မွဲရ။"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "မွန်ဘာသာစကား (mnw) သည် ကျွန်ုပ်၏ မိခင်ဘာသာစကား ဖြစ်သည်။ လက်ရှိတွင် UNESCO မှ ထိန်းသိမ်းရန် လိုအပ်သော ဘာသာစကားအဖြစ် သတ်မှတ်ထားသည်။"
          }
        }
      }
    },
    "about_digital_presence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The biggest challenge is the lack of digital presence for Mon. This makes AI development difficult since most texts are in scanned books."
          }
        },
        "mnw": {
          "stringUnit": {
            "state": "translated",
            "value": "ပြသနာဇၞော်အိုတ်ဂှ် ပ္ဍဲကဵုလောက ဒစ်ဂျစ်တယ်ဂှ် လိခ်မန်ပိုဲ နွံအောန်ကွေဟ်ရ။ ဟိုတ်ဂှ်တုဲ သွက်ဂွံပတုဲအာ ကမၠောန် AI ဂှ် ဝါတ်ဂါတ်ဒၟံင်ရ။ လိခ်ပိုဲ ဗွဲမဂၠိုင်ဂှ် နွံဒၟံင် ပ္ဍဲကဵု လိခ်ကၞပ် စကင်န်တအ်ရ။"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အကြီးမားဆုံး စိန်ခေါ်မှုမှာ မွန်ဘာသာစကား၏ ဒစ်ဂျစ်တယ် တည်ရှိမှု နည်းပါးခြင်းဖြစ်သည်။ ထို့ကြောင့် AI ဖွံ့ဖြိုးတိုးတက်မှုအတွက် ခက်ခဲစေသည်။"
          }
        }
      }
    },
    "about_effort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To increase digital presence, I developed this OCR engine. It uses MobileNetV3 + BiLSTM for efficient inference."
          }
        },
        "mnw": {
          "stringUnit": {
            "state": "translated",
            "value": "သွက်ဂွံဇမြော်ပတိုန် လိခ်မန် ပ္ဍဲလောက ဒစ်ဂျစ်တယ်ဂှ် အဲဇန်လဝ် အင်ဂျင် OCR သွက်ဂွံဗှ်လိခ်မန်ရ။ မော်ဒယ်လၟုဟ်ဝွံ စကာလဝ် MobileNetV3 + BiLSTM သွက်ဂွံဗှ်လိခ်မန် ညံင်ဂွံဂွံတင်ဂုဏ်ဖိုလ်ရ။"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဒစ်ဂျစ်တယ် တည်ရှိမှု တိုးတက်စေရန် ဤ OCR အင်ဂျင်ကို တည်ဆောက်ခဲ့သည်။ MobileNetV3 + BiLSTM ကို အသုံးပြုထားသည်။"
          }
        }
      }
    },
    "about_inference": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine uses ONNX Runtime Web to run locally in your browser. Your data never leaves your device."
          }
        },
        "mnw": {
          "stringUnit": {
            "state": "translated",
            "value": "အင်ဂျင်ဝွံ စကာလဝ် ONNX Runtime Web တုဲ ကၠောန်ကမၠောန် ပ္ဍဲဘရောက်ဇာ မၞးရ။ ဟွံဒးပလံင် တင်ဂရင် ပ္ဍဲဆာဗာတုဲ နွံကဵုဂီုက္ဍဟ်ရ။"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဤအင်ဂျင်သည် ONNX Runtime Web ကို အသုံးပြု၍ သင့်ဘရောက်ဇာတွင် တိုက်ရိုက် အလုပ်လုပ်ပါသည်။ သင်၏ အချက်အလက်များ ပြင်ပသို့ မရောက်ရှိပါ။"
          }
        }
      }
    },
    "about_hope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MonOCR aims to bridge the gap between physical texts and digital data, enabling new educational possibilities."
          }
        },
        "mnw": {
          "stringUnit": {
            "state": "translated",
            "value": "ဣဝွံ ဒှ်ကမၠောန် ဍောတ်တ်မွဲကီုလေဝ် အဲမိက်ဂွံကဵု MonOCR ဂှ် ဗိုင်ရီု သွက်ဂွံပြံင်လှာဲ လိခ်ပိုဲ ညံင်ဂွံဒှ် ဒစ်ဂျစ်တယ်တုဲ ဖန်ဗဒှ်အာ သွက်ပညာတၟိတၟိတအ်ရ။"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "မွန် OCR သည် စာအုပ်များမှ အချက်အလက်များကို ဒစ်ဂျစ်တယ်အဖြစ်သို့ ပြောင်းလဲပေးရန် ရည်ရွယ်သည်။"
          }
        }
      }
    },
