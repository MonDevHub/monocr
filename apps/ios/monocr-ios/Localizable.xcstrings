    },
    "Because we do not collect data, we do not anticipate needing to update this policy often. If fundamental changes to the application architecture occur, we will reflect those in our open source repositories and in-app documentation.": {
      "extractionState": "manual",
      "localizations": {
        "mnw": {
          "stringUnit": {
            "state": "translated",
            "value": "Because we do not collect data, we do not anticipate needing to update this policy often. If fundamental changes to the application architecture occur, we will reflect those in our open source repositories and in-app documentation."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ကျွန်ုပ်တို့သည် အချက်အလက်များ သိမ်းဆည်းခြင်းမပြုသောကြောင့် ဤမူဝါဒကို မကြာခဏပြောင်းလဲရန် မလိုအပ်ပါ။ အကယ်၍ အက်ပလီကေးရှင်း၏ နည်းပညာဆိုင်ရာ အခြေခံအချက်များ ပြောင်းလဲသွားပါက open source repositories နှင့် အက်ပလီကေးရှင်းအတွင်း၌ အသိပေးသွားမည်ဖြစ်သည်။"
          }
        }
      }
    },
