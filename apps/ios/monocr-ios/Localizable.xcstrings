    "Allow this feedback to be used for model verification and archival research.": {
      "extractionState": "manual",
      "localizations": {
        "mnw": {
          "stringUnit": {
            "state": "translated",
            "value": "ကဵုအခေါင် စကာတင်ဂရင်ဏအ် သွက်ဂွံစၟတ်သမ္တီ မော်ဒယ် ညိ။"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဤအချက်အလက်များကို မော်ဒယ်စစ်ဆေးခြင်းနှင့် သုတေသနလုပ်ငန်းများတွင် အသုံးပြုခွင့်ပေးပါ။"
          }
        }
      }
    },
    "Any images you select from your library or capture via your camera are loaded straight into the Neural Processing Unit (ANE) on your local hardware. The original image and the generated text extraction both remain isolated in your device's memory.": {
      "extractionState": "manual",
      "localizations": {
        "mnw": {
          "stringUnit": {
            "state": "translated",
            "value": "Any images you select from your library or capture via your camera are loaded straight into the Neural Processing Unit (ANE) on your local hardware. The original image and the generated text extraction both remain isolated in your device's memory."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သင်ရွေးချယ်လိုက်သော သို့မဟုတ် ဓာတ်ပုံရိုက်လိုက်သောပုံများကို သင့်စက်၏ Neural Processing Unit (ANE) အတွင်းသို့ တိုက်ရိုက်ထည့်သွင်းလုပ်ဆောင်ပါသည်။ မူရင်းပုံနှင့် ထွက်ပေါ်လာသောစာသားများအားလုံးကို သင့်စက်၏မှတ်ဉာဏ်အတွင်း၌သာ သီးသန့်ထားရှိပါသည်။"
          }
        }
      }
    },
