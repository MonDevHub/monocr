    "docs_getting_started_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MonOCR Web works directly in your browser. No installation required. Upload an image or PDF to start."
          }
        },
        "mnw": {
          "stringUnit": {
            "state": "translated",
            "value": "MonOCR Web ဂှ် ကၠောန်ကမၠောန် ပ္ဍဲဘရောက်ဇာရ။ ဟွံဒးစုတ် software။ စုတ်ပ္တိုန်ရုပ် သာ်ဟွံသေင် PDF တုဲ စကာမာန်ရ။"
          }
        },
        "my": {
