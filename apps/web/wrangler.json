{
	"name": "monocr-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2024-11-12",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			"binding": "MONOCR_DATASET",
			"bucket_name": "monocr-dataset"
		}
	]
}
