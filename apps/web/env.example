# Google Cloud Console
# Get these from: IAM & Admin > Service Accounts > Create Key (JSON)
GOOGLESHEET_PROJECT_ID=your-project-id
GOOGLESHEET_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
GOOGLESHEET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=monocr