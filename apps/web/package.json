{
	"name": "@monocr/web",
	"private": true,
	"version": "0.4.0",
	"type": "module",
	"scripts": {
		"prepare": "node scripts/copy-wasm.mjs && node scripts/copy-pdf-worker.mjs && pnpm run paraglide && svelte-kit sync || echo ''",
		"dev": "node scripts/copy-wasm.mjs && node scripts/copy-pdf-worker.mjs && vite dev",
		"start": "vite preview",
		"preview": "vite preview",
		"paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"copy-wasm": "node scripts/copy-wasm.mjs",
		"copy-pdf-worker": "node scripts/copy-pdf-worker.mjs",
		"build": "pnpm run copy-wasm && pnpm run copy-pdf-worker && vite build --mode production && rm -f .svelte-kit/cloudflare/monocr.onnx",
		"build-local": "pnpm run copy-wasm && pnpm run copy-pdf-worker && vite build && rm -f .svelte-kit/cloudflare/monocr.onnx",
		"build:analyze": "pnpm run copy-wasm && pnpm run copy-pdf-worker && vite build --mode production --analyze",
		"build:minimal": "pnpm run copy-wasm && pnpm run copy-pdf-worker && vite build --mode production --minify terser",
		"format": "prettier --write . && eslint --fix .",
		"format:check": "prettier --check .",
		"lint": "prettier --check . && eslint .",
		"type-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check": "pnpm run type-check",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:unit": "vitest",
		"test:watch": "vitest --watch",
		"scan:secrets": "gitleaks git --redact --verbose ../..",
		"scan:deps": "pnpm audit",
		"size": "pnpm run build && du -sh build/* | sort -hr",
		"ci": "pnpm run format:check && pnpm run lint && pnpm run type-check && pnpm run scan:secrets && pnpm run scan:deps",
		"parse:locale": "node scripts/parseLocaleFiles.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@inlang/paraglide-js": "^2.25.4",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.52.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^25.2.3",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.10",
		"dotenv": "^17.4.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"googleapis": "^171.4.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^7.3.1",
		"vite-plugin-top-level-await": "^1.6.0",
		"vite-plugin-wasm": "^3.5.0",
		"vitest": "^4.1.10",
		"workbox-window": "^7.4.1",
		"wrangler": "^4.147.0"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1147.0",
		"@aws-sdk/s3-request-presigner": "^3.1147.0",
		"dexie": "^4.4.6",
		"onnxruntime-web": "~1.24.3",
		"pdfjs-dist": "^4.10.38"
	},
	"packageManager": "pnpm@10.25.0"
}
