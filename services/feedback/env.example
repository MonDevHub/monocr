# Server Configuration
PORT=8080
GIN_MODE=release

# Security
API_KEY=your-secret-api-key-here

# Cloudflare R2 Credentials
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=bucket_name

# Operational Tuning (Optional)
RATE_LIMIT_REQUESTS=5.0
RATE_LIMIT_BURST=10

# Trusted proxy IPs or CIDRs, comma separated. Optional.
#
# Unset leaves gin's default, which trusts every hop and so rate-limits on the
# client-supplied end of X-Forwarded-For: per-user rather than one global
# bucket, but a caller that rotates the header gets a fresh quota. Set this to
# the range your front end actually connects from to make the client IP
# unforgeable. A value that will not parse stops the service at boot.
TRUSTED_PROXIES=
