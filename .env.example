# Google Sheets API (for localization sync)
GOOGLESHEET_PROJECT_ID=your-project-id
GOOGLESHEET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLESHEET_CLIENT_EMAIL=your-sa-email@project.iam.gserviceaccount.com

# Cloudflare R2 / S3 Storage (for feedback/contributions)
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_ACCOUNT_ID=your-account-id
R2_BUCKET_NAME=your-bucket-name

# Backend Configuration
PORT=8080
API_KEY=your-secure-api-key
GIN_MODE=debug

# Operational Tuning
RATE_LIMIT_REQUESTS=5.0
RATE_LIMIT_BURST=10
